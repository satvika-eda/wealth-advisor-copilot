# ── Application ───────────────────────────────────────────────────────────────
DEBUG=false
API_V1_PREFIX=/api/v1

# ── Database ───────────────────────────────────────────────────────────────────
# REQUIRED — must be set before starting the server
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/wealth_advisor

# ── OpenAI ─────────────────────────────────────────────────────────────────────
# REQUIRED
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_CHAT_MODEL=gpt-4o

# ── Cohere ─────────────────────────────────────────────────────────────────────
# Optional — enables cross-encoder reranking; falls back to vector similarity if unset
COHERE_API_KEY=

# ── Authentication ─────────────────────────────────────────────────────────────
# REQUIRED — generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=REPLACE-WITH-SECURE-RANDOM-VALUE
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# ── CORS ───────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# ── Rate Limiting ──────────────────────────────────────────────────────────────
RATE_LIMIT_CHAT=30/minute
RATE_LIMIT_INGEST=10/minute
RATE_LIMIT_DEFAULT=200/hour

# ── Field-level Encryption ─────────────────────────────────────────────────────
# Encrypts audit log user_query and response_text at rest.
# Leave empty in development to disable.
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEY=

# ── Admin Seed User ────────────────────────────────────────────────────────────
# Set to seed a default admin account on first startup (email: admin@wealthadvisor.local).
# Leave empty to skip seeding — use /api/v1/auth/register instead.
ADMIN_SEED_PASSWORD=

# ── RAG Configuration ──────────────────────────────────────────────────────────
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
RETRIEVAL_TOP_K=30
RERANK_TOP_K=10
